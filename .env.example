# ==========================================
# DevIgnite AI Support Bot Configuration
# ==========================================

# 1. Database URL (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"
# Or for PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/devignite_chatbot?schema=public"

# 2. AI Model API Keys (Provide at least one)
GOOGLE_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# 3. Pinecone Vector DB (Required for RAG knowledge retrieval)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX="devignite-kb"
PINECONE_ENVIRONMENT="us-east-1"

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Calendly Integration (Optional - for meeting scheduling)
CALENDLY_API_TOKEN="your-calendly-token"
CALENDLY_EVENT_TYPE_URI="your-calendly-event-type-uri"
